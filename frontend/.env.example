# Google Maps Platform API Key
# To obtain a free prototype key without a billing account, visit:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_git_agentskills_v1
# For production keys, create and restrict a key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_git_agentskills_v1
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID (Web Client ID configured with authorized origins for http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
