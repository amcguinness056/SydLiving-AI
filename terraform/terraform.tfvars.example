# Copy this file to terraform.tfvars and update with your GCP project values
project_id           = "your-gcp-project-id"
region               = "australia-southeast1" # Sydney
environment          = "production"
app_name             = "sydliving"
db_path              = "/data/sydliving.db"

# API Keys (stored securely in Google Secret Manager)
gemini_api_key       = "AIzaSy..."
google_maps_api_key  = "AIzaSy..."
domain_api_key       = "your-domain-api-key" # Optional

# Additional CORS origins (e.g. your custom domain)
allowed_origins      = [
  "http://localhost:5173",
  "http://localhost:3000"
]

# GitHub Repository for Workload Identity Federation (Keyless GitHub Actions)
github_repo          = "your-username/SydLiving-AI"
