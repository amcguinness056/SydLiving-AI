# =================================================================
# SydLivingAI Environment Variables
# =================================================================
# Copy this file to `backend/.env` and supply your API credentials.
# Note: The app includes graceful local fallbacks for all services,
# but GEMINI_API_KEY is strongly recommended for conversational chat.

# 1. Google Gemini API Key (Required for AI Chat & Gemini Agent)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Transport for NSW Open Data Hub API Key (Optional - for live transit times)
# Register & subscribe to "Trip Planner" at: https://opendata.transport.nsw.gov.au/
# (If omitted, uses pre-calibrated Sydney transit matrix fallback)
TFNSW_API_KEY=your_tfnsw_api_key_here

# 3. Domain Group Developer API Key (Optional - for live rental listings)
# Register at: https://developer.domain.com.au/
# (If omitted, uses rich curated Sydney rental properties database)
DOMAIN_API_KEY=your_domain_api_key_here

# 4. AWS Credentials (Optional for local dev, required for cloud deployment)
# Used for AWS Textract OCR, AWS Comprehend NLP, DynamoDB, & Step Functions
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2

# Optional AWS Service Overrides:
# USE_DYNAMODB=true
# DYNAMODB_TABLE_NAME=SydLiving-Core
# PROPERTY_ORCHESTRATOR_SFN_ARN=arn:aws:states:ap-southeast-2:ACCOUNT_ID:stateMachine:SydLiving-PropertyOrchestrator
